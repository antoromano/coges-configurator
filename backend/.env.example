# Connessione al database PostgreSQL su Railway.
# Copia il valore da Railway: apri il servizio Postgres del tuo progetto,
# tab "Variables", copia il valore di DATABASE_URL (o "DATABASE_PUBLIC_URL"
# se lo esegui da fuori Railway, come in questo caso — sviluppo in locale).
# NON committare mai il file .env reale (solo questo .env.example va in Git).
DATABASE_URL=postgresql://postgres:PASSWORD@containers-us-west-XX.railway.app:XXXX/railway

# Origini permesse per CORS (frontend Vite in sviluppo)
CORS_ORIGINS=http://localhost:5173

# Modalita' debug (True per sviluppo)
DEBUG=True

# Password condivisa per l'area interna staff (GET/PATCH /api/quote-requests).
# Cambiala con un valore a tua scelta, non lasciare quello di esempio.
STAFF_ACCESS_TOKEN=cambia-questa-password
